# Copy this file to .env and fill in your values.
# The core swipe loop works WITHOUT a key (seed ideas are served).
# A key is only needed for /generate and /ideas/{id}/echo.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SQLite file location (relative to backend-swipey/). Created automatically.
DATABASE_PATH=data/swipey.db

# Default user id when the X-User-Id header is absent.
DEFAULT_USER_ID=demo

# Dedup threshold: ideas with Jaccard token overlap above this are dropped.
DEDUP_THRESHOLD=0.6
